              <DockPanel Margin="0,12,0,3"><TextBlock Text="面板实度" Style="{StaticResource Muted}"/><TextBlock x:Name="PanelOpacityValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></DockPanel><Slider x:Name="PanelOpacitySlider" Minimum="0.78" Maximum="0.97" TickFrequency="0.01" ValueChanged="Appearance_Changed" AutomationProperties.Name="界面面板不透明度"/>
              <DockPanel Margin="0,12,0,3"><TextBlock Text="主体横向位置" Style="{StaticResource Muted}"/><TextBlock x:Name="FocusXValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></DockPanel><Slider x:Name="FocusXSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="Appearance_Changed" AutomationProperties.Name="背景主体横向位置"/>
              <DockPanel Margin="0,12,0,3"><TextBlock Text="主体纵向位置" Style="{StaticResource Muted}"/><TextBlock x:Name="FocusYValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></DockPanel><Slider x:Name="FocusYSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="Appearance_Changed" AutomationProperties.Name="背景主体纵向位置"/>
            </StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" Background="#F0101929" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" Padding="24,12,24,10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="19"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionLabel" Text="00:00" Style="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/><Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Progress_Changed" PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp" AutomationProperties.Name="播放进度" Margin="10,0"/><TextBlock x:Name="DurationLabel" Grid.Column="2" Text="00:00" Style="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="130"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="FooterTitle" Text="尚未选曲" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ModeLabel" Text="安全模式 · 仅本地试听" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0"><Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" ToolTip="上一首" AutomationProperties.Name="上一首" Click="Previous_Click" Margin="0,0,6,0"/><Button x:Name="PreviewButton" Content="本地试听" Style="{StaticResource Primary}" Click="Preview_Click" Margin="0,0,6,0"/><Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" Style="{StaticResource Subtle}" Margin="0,0,6,0"/><Button x:Name="StopButton" Content="停止" Click="Stop_Click" Style="{StaticResource Subtle}" Margin="0,0,6,0"/><Button x:Name="GameButton" Content="启用快捷演奏" Foreground="{StaticResource GoldBrush}" Click="Game_Click" Style="{StaticResource Subtle}" Margin="0,0,6,0"/><Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" ToolTip="下一首" AutomationProperties.Name="下一首" Click="Next_Click"/></StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="试听音量" Style="{StaticResource Muted}" FontSize="10"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.65" TickFrequency="0.05" ValueChanged="Volume_Changed" AutomationProperties.Name="试听音量"/></StackPanel>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="就绪 · 不会自动向游戏发送按键" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
      </Grid>
    </Border>
  </Grid>
</Grid>
</Window>

