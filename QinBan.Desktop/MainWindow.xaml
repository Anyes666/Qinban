      <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=EditorPage}" Value="Visible"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="EditorPage" Visibility="Collapsed" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions><Grid Margin="0,0,22,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="新建文本谱" Click="NewScore_Click" /><Button Content="载入当前曲谱 JSON" Click="LoadEditor_Click" Margin="8,0,0,0" /></DockPanel><TextBox x:Name="EditorBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="15" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="谱子文本编辑器" /><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="EditorPreviewButton" Content="校验并试听" Style="{StaticResource Primary}" Click="EditorPreview_Click" /><Button x:Name="EditorSaveButton" Content="另存到我的曲库" Click="EditorSave_Click" Margin="8,0,0,0" /><TextBlock x:Name="EditorResult" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" /></StackPanel></Grid><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="用熟悉的方式写谱" FontSize="20" Margin="0,0,0,18" /><TextBlock Text="键位谱：QWERTYU / ASDFGHJ / ZXCVBNM。默认来源为诗琴；INSTRUMENT=euphonia 可指定「余音」源键位。连续按键逐个演奏，括号表示同拍和弦。" TextWrapping="Wrap" Style="{StaticResource Muted}" /><TextBlock Text="BPM=100&#10;FORMAT=keys&#10;TITLE=我的第一首&#10;A A G G H H G:2&#10;(ADG):2 - A" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,15" Foreground="{StaticResource GoldBrush}" /><TextBlock Text="数字简谱：1–7 是中音，1' 是高八度，1, 是低八度，#1 / b3 表示升降音，0 是休止。:2 为两拍，:0.5 为半拍，| 只作分隔。" TextWrapping="Wrap" Style="{StaticResource Muted}" /><TextBlock Text="FORMAT=numbered&#10;1 1 5 5 6 6 5:2&#10;(135):2 0 1':2" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,15" Foreground="{StaticResource GoldBrush}" /><TextBlock Text="谱头：AUTHOR 是作者 / 编谱者；ARTISTS 用 | 分隔歌手，LANGUAGES 用 | 分隔语种标签，未知填 und；ALBUM 是专辑，EDITION 是版本。工坊保存总是创建新谱，不覆盖原文件。JSON 可精确修改音高、起始时间、时值和轨道。PDF、图片和 MP3 不在本版导入范围内。" TextWrapping="Wrap" Style="{StaticResource Muted}" /></StackPanel></ScrollViewer></Grid>
    </Border>
<Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=SettingsPage}" Value="Visible"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0"><StackPanel MaxWidth="850" HorizontalAlignment="Left">
      <TextBlock Text="安全优先，再开始演奏。" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12" /><TextBlock Text="软件只发送所选乐器配置中的按键，不读取游戏内存、不注入进程、不绕过反作弊，也不自动获取管理员权限。普通按键模拟不等于官方许可，使用风险需自行判断。" TextWrapping="Wrap" Style="{StaticResource Muted}" />
      <TextBlock Text="原神目标窗口" Style="{StaticResource Label}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="TargetCombo" MinWidth="440" AutomationProperties.Name="原神目标窗口" SelectionChanged="GameAuthorization_Changed" /><Button Grid.Column="1" Content="刷新窗口" Click="RefreshTargets_Click" Margin="10,0,0,0" /></Grid><TextBlock Text="仅识别 YuanShen.exe / GenshinImpact.exe 的可见窗口。窗口存在不代表已打开乐器；云原神和其他进程名不在本版支持范围。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
      <TextBlock Text="无倒计时快捷演奏" Style="{StaticResource Label}" />
      <TextBlock Text="本次启动先启用快捷演奏。之后选好歌曲和乐器，在选定原神前台按 Shift+Enter，松开 Shift 与 Enter 即开始；不会自动切窗口。" Style="{StaticResource Muted}" TextWrapping="Wrap" />
      <CheckBox x:Name="GameConsent" Unchecked="GameAuthorization_Changed"><TextBlock Text="我了解自动演奏风险；每次快捷启动前会打开对应乐器、关闭聊天与菜单，并核对所选谱子和乐器。" TextWrapping="Wrap" /></CheckBox>
      <TextBlock Text="Shift+Enter：松键即开始；F8：暂停 / 继续；F9：停止 / 取消待启动。演奏时失焦或按住修饰键会停止。F9 或 Shift+Enter 注册失败不能启用游戏输出。更改窗口/撤销风险授权需重新启用。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <TextBlock Text="播放队列" Style="{StaticResource Label}" /><CheckBox x:Name="QueueAutoCheck" Content="当前谱子试听结束后，继续试听队列下一首（不自动开始游戏按键）" />
      <TextBlock Text="我的数据" Style="{StaticResource Label}" /><TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" TextWrapping="Wrap" /><Button Content="打开数据文件夹" Click="OpenData_Click" HorizontalAlignment="Left" Margin="0,12,0,0" /><TextBlock Text="原始导入文件副本保存在 originals，标准化谱子在 scores。收藏、队列和每曲参数保存在 library.json。界面不会删除原始文件。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel></ScrollViewer>
    </Border>
<Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=HelpPage}" Value="Visible"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0"><StackPanel MaxWidth="850" HorizontalAlignment="Left">
      <TextBlock Text="从第一声，到整首歌。" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="01  可用曲名、歌手、语种、专辑、版本或其组合搜索（空格分隔），也支持别名、拼音和首字母。选一首谱子，点“本地试听”；合成声音用于检查节奏，不是原神原始音色。" TextWrapping="Wrap" Margin="0,25,0,0" FontSize="16" />
      <TextBlock Text="02  在右侧调整速度、移调、和弦与轨道。查看适配报告：被折叠、替换或省略的音符会统计出来。修改参数会停止当前播放，之后请重新试听。" TextWrapping="Wrap" Margin="0,22,0,0" FontSize="16" />
      <TextBlock Text="03  在“安全与设置”刷新并选定原神窗口、确认风险。选择对应乐器并点“启用快捷演奏”（本次会话一次）。进入游戏打开该乐器、关闭聊天，按 Shift+Enter，松键即开始；没有倒计时。" TextWrapping="Wrap" Margin="0,22,0,0" FontSize="16" />
      <TextBlock Text="04  F8 暂停 / 继续，F9 随时停止。切出原神会停止；重新演奏需主动再次按 Shift+Enter，不会偷偷恢复后台输入。" TextWrapping="Wrap" Margin="0,22,0,0" FontSize="16" />
      <TextBlock Text="支持与限制" FontSize="18" Margin="0,28,0,10" /><TextBlock Text="• 乐器按各自键位、音域和和弦规则适配；同键快速重复或高密度和弦可能在游戏中漏音。&#10;• MIDI 保留全局变速时间，打击乐默认排除，建议只选旋律或少量伴奏轨道。&#10;• TXT 支持键位谱和本工具约定的数字简谱，不是任意网页文本自动识别。&#10;• JSON 支持琴伴 version=1；songNotes 按原神 21 键索引解读，不能通用保证光遇等其他游戏格式。&#10;• 本地试听最多渲染前 10 分钟；游戏谱子上限 30 分钟 / 100,000 音 / 16 MB。&#10;• 鼓类键位待核验，暂不输出；乐器资料与图标来源见随包说明。新乐器音域和快捷启动仍需游戏内验收。&#10;• 长短音与休止来自谱面时值；等拍且缺少时值的输入不能自动还原原曲节奏。" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="27" />
      <TextBlock Text="内置 30 份教学示范" FontSize="18" Margin="0,26,0,10" /><TextBlock Text="包含传统旋律主题短编、原创小曲和演奏练习；不是 30 首热门商业歌曲的完整授权曲库。你可以批量导入自己的收藏。所有处理在本地进行，不向服务器上传谱子。" Style="{StaticResource Muted}" TextWrapping="Wrap" />
      <TextBlock Text="独立 GPL 派生工作台；源代码和上游说明随项目提供。不是 Auto MIDI Player 或原神官方发行版。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,28,0,25" />
    </StackPanel></ScrollViewer>
  </Border>
