{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QinBan Desktop",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/QinBan.Desktop/bin/Debug/net10.0-windows/QinBan.exe",
      "args": ["--data-dir", "${workspaceFolder}/.validation/vscode/UserData"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
