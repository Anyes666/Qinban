{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/QinBan.slnx"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "QinBan: core tests",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/QinBan.Tests", "--", "${workspaceFolder}/.validation/core-vscode"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile"
    }
  ]
}
