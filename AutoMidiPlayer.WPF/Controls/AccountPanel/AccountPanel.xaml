<UserControl x:Class="AutoMidiPlayer.WPF.Controls.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:s="https://github.com/canton7/Stylet"
             xmlns:viewModels="clr-namespace:AutoMidiPlayer.WPF.ViewModels"
             xmlns:converters="clr-namespace:AutoMidiPlayer.WPF.Converters"
             xmlns:controls="clr-namespace:AutoMidiPlayer.WPF.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:OnlineMidiViewModel}">

    <UserControl.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <Style x:Key="AccentHyperlink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#2EA043"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ============ Header (static) ============ -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="HeaderText" Text="MidiShow accounts" FontWeight="SemiBold" FontSize="15"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding AccountSummary}" Opacity="0.6" FontSize="12" Margin="0,0,0,12"/>

        <!-- ============ Configured accounts (static) ============ -->
        <ItemsControl ItemsSource="{Binding Accounts}"
                      Visibility="{Binding HasAnyAccount, Converter={x:Static s:BoolToVisibilityConverter.Instance}}"
                      Margin="0,0,0,4">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:MidiShowAccountRow}">
                    <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8"
                            Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                     Margin="0,0,10,0" Fill="{Binding StatusBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11" Opacity="0.6">
                                    <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Grid Grid.Column="2">
                                <controls:Button Variant="Filled" ColorMode="Default" Padding="7,5" Margin="0,0,6,0"
                                           ToolTip="Copy this account's session cookies"
                                           Visibility="{Binding CanCopyCookies, Converter={x:Static s:BoolToVisibilityConverter.Instance}}"
                                           Click="CopyCookies_Click"
                                           Icon="Copy24" />
                                <controls:Button Variant="Filled" ColorMode="Default" Padding="7,5" Margin="0,0,6,0"
                                           ToolTip="Reset account state (e.g. if you verified email or waited out a limit)"
                                           Visibility="{Binding IsErrorState, Converter={x:Static s:BoolToVisibilityConverter.Instance}}"
                                           Click="RefreshAccount_Click"
                                           Icon="ArrowClockwise24" />
                            </Grid>
                            <controls:Button Grid.Column="3" Variant="Filled" ColorMode="Default" Padding="7,5"
                                       ToolTip="Remove this account"
                                       Click="RemoveAccount_Click">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#E04F4F"/>
                            </controls:Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0,6,0,10"/>

        <!-- ============================================================
             SLIDING PANELS  (uses the reusable SlidingPanelHost)
             Panel 0 — Action buttons   (default)
             Panel 1 — Post-signup prompt
             Panel 2 — Sign-in form
             ============================================================ -->
        <controls:SlidingPanelHost x:Name="PanelSlider">

            <!-- ====== Panel 0: Side-by-side action buttons ====== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:Button x:Name="CreateAccountButton"
                           Grid.Column="0"
                           Variant="Filled" ColorMode="Accent"
                           HorizontalAlignment="Stretch"
                           Padding="0,9"
                           Click="CreateAccount_Click"
                           Icon="PersonAdd24"
                           Content="Create account" />

                <controls:Button Grid.Column="2"
                           Variant="Filled" ColorMode="Default"
                           HorizontalAlignment="Stretch"
                           Padding="0,9"
                           Click="SignInButton_Click"
                           Icon="PersonCircle24"
                           Content="Sign in" />
            </Grid>

            <!-- ====== Panel 1: Post-signup prompt ====== -->
            <StackPanel>
                <TextBlock TextAlignment="Center" FontSize="13"
                           Margin="0,8,0,12" TextWrapping="Wrap">
                    <Run Text="Go to "/><InlineUIContainer BaselineAlignment="Center"><controls:Hyperlink PreviewToolTip="{Binding SignUpUrl, RelativeSource={RelativeSource AncestorType=controls:AccountPanel}}" Click="OpenSignUpPage_Click" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" MinHeight="0"><TextBlock x:Name="SignUpSiteNameRun" Text="MidiShow" FontSize="13"/></controls:Hyperlink></InlineUIContainer><Run Text=" account creation page"/>
                </TextBlock>

                <TextBlock TextAlignment="Center" FontSize="13" Opacity="0.7"
                           Margin="0,0,0,10" TextWrapping="Wrap">
                    <Run Text="Done creating? "/><InlineUIContainer BaselineAlignment="Center"><controls:Hyperlink Click="SignInLink_Click" IsPreviewToolTipEnabled="False" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" MinHeight="0"><TextBlock Text="Sign in" FontSize="13"/></controls:Hyperlink></InlineUIContainer><Run Text=" to your account"/>
                </TextBlock>
            </StackPanel>

            <!-- ====== Panel 2: Sign-in form ====== -->
            <StackPanel>
                <CheckBox Content="Use cookies instead of a password"
                          IsChecked="{Binding IsAddingCookie}"
                          Margin="0,0,0,10"/>

                <!-- Inline validation / error -->
                <Border Margin="0,0,0,10"
                        Padding="10,8"
                        CornerRadius="6"
                        Background="#33E04F4F"
                        BorderBrush="#E04F4F"
                        BorderThickness="1"
                        Visibility="{Binding HasAddAccountError, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="15" Foreground="#E04F4F"
                                       VerticalAlignment="Top" Margin="0,1,8,0"/>
                        <TextBlock Text="{Binding AddAccountError}" Foreground="#F2B8B8"
                                   TextWrapping="Wrap" FontSize="12.5" MaxWidth="270"/>
                    </StackPanel>
                </Border>

                <!-- Password mode -->
                <StackPanel Visibility="{Binding IsAddingPassword, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                    <ui:TextBox Margin="0,0,0,8"
                                PlaceholderText="Email or username"
                                ClearButtonEnabled="False"
                                Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:PasswordBox x:Name="PasswordBox"
                                        Grid.Column="0"
                                        PlaceholderText="Password"
                                        PasswordChar="•"
                                        ClearButtonEnabled="False"
                                        RevealButtonEnabled="False"
                                        Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        KeyDown="PasswordBox_KeyDown"
                                        Visibility="{Binding IsPasswordRevealed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <ui:TextBox Grid.Column="0"
                                    PlaceholderText="Password"
                                    ClearButtonEnabled="False"
                                    Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    KeyDown="PasswordBox_KeyDown"
                                    Visibility="{Binding IsPasswordRevealed, Converter={x:Static s:BoolToVisibilityConverter.Instance}}"/>

                        <controls:Button Grid.Column="1"
                                         Margin="6,0,0,0"
                                         Padding="9,0"
                                         VerticalAlignment="Stretch"
                                         ToolTip="Show / hide password"
                                         Variant="Ghost"
                                         Command="{s:Action ToggleReveal}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Eye16" FontSize="16" Opacity="0.75"
                                               Visibility="{Binding IsPasswordRevealed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <ui:SymbolIcon Symbol="EyeOff16" FontSize="16" Opacity="0.75"
                                               Visibility="{Binding IsPasswordRevealed, Converter={x:Static s:BoolToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </controls:Button>
                    </Grid>
                    <Grid>
                        <controls:Button Variant="Filled" ColorMode="Accent"
                                         Icon="PersonAdd24"
                                         Content="Add account"
                                         HorizontalAlignment="Stretch"
                                         Padding="0,9"
                                         IsEnabled="{Binding IsNotAddingAccount}"
                                         Command="{s:Action AddPasswordAccount}"
                                         Visibility="{Binding IsAddingAccount, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <controls:Button Variant="Filled" ColorMode="Accent"
                                         HorizontalAlignment="Stretch"
                                         Padding="0,9"
                                         IsEnabled="False"
                                         Visibility="{Binding IsAddingAccount, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </controls:Button>
                    </Grid>
                </StackPanel>

                <!-- Cookie mode -->
                <StackPanel Visibility="{Binding IsAddingCookie, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                    <ui:TextBox Margin="0,0,0,8"
                                PlaceholderText="Account label (e.g. alt #1)"
                                ClearButtonEnabled="False"
                                Text="{Binding NewCookieLabel, UpdateSourceTrigger=PropertyChanged}"/>
                    <ui:TextBox Margin="0,0,0,10"
                                MinHeight="70" MaxHeight="120"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                ClearButtonEnabled="False"
                                PlaceholderText="Paste cookie header (_identity=...; _csrf=...; ...)"
                                VerticalScrollBarVisibility="Auto"
                                Text="{Binding NewCookies, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid>
                        <controls:Button Variant="Filled" ColorMode="Accent"
                                         Icon="PersonAdd24"
                                         Content="Add account"
                                         HorizontalAlignment="Stretch"
                                         Padding="0,9"
                                         IsEnabled="{Binding IsNotAddingAccount}"
                                         Command="{s:Action AddCookieAccount}"
                                         Visibility="{Binding IsAddingAccount, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <controls:Button Variant="Filled" ColorMode="Accent"
                                         HorizontalAlignment="Stretch"
                                         Padding="0,9"
                                         IsEnabled="False"
                                         Visibility="{Binding IsAddingAccount, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </controls:Button>
                    </Grid>

                    <Expander Margin="0,12,0,0"
                              Header="How to copy your cookies">
                        <StackPanel Margin="2,10,2,2">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Use this when a password sign-in is blocked by a captcha or risk control."/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="1.  Sign in to midishow.com in your browser."/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="2.  Open DevTools (F12) → Application/Storage → Cookies → www.midishow.com."/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="3.  Copy the cookies as a single 'name=value; name2=value2' line (the _identity cookie is required)."/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                       Text="4.  Paste them above and add the account."/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>

        </controls:SlidingPanelHost>
    </StackPanel>
</UserControl>
